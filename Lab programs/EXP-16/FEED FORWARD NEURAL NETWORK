from sklearn.neural_network import MLPClassifier

# XOR input
X = [
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
]

# XOR output
y = [0, 1, 1, 0]

# Create feed-forward neural network
model = MLPClassifier(
    hidden_layer_sizes=(4,),
    activation="relu",
    max_iter=5000,
    random_state=1
)

# Train network
model.fit(X, y)

# Test input
a = int(input("Enter first value (0 or 1): "))
b = int(input("Enter second value (0 or 1): "))

result = model.predict([[a, b]])

print("Predicted Output:", result[0])
