% Best First Search
best_first(Start, Goal, Path) :-
    best_first_search([Start], Goal, [Start], Path).

best_first_search([Goal|_], Goal, _, [Goal]).

best_first_search([Current|Open], Goal, Visited, [Current|Path]) :-
    findall(
        Next,
        (edge(Current, Next), \+ member(Next, Visited)),
        Children
    ),
    append(Open, Children, NewOpen),
    sort_by_heuristic(NewOpen, SortedOpen),
    SortedOpen = [Next|_],
    best_first_search(
        SortedOpen,
        Goal,
        [Next|Visited],
        Path
    ).

sort_by_heuristic([], []).

sort_by_heuristic(Nodes, Sorted) :-
    map_list_to_pairs(heuristic, Nodes, Pairs),
    keysort(Pairs, SortedPairs),
    pairs_values(SortedPairs, Sorted).

heuristic(Node, H) :-
    h(Node, H).
