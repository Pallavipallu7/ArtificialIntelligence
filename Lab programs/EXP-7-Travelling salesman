from itertools import permutations

graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

n = len(graph)
cities = list(range(n))

min_cost = float('inf')
best_path = None

for path in permutations(cities[1:]):
    current_cost = 0
    current_city = 0

    for city in path:
        current_cost += graph[current_city][city]
        current_city = city

    current_cost += graph[current_city][0]

    if current_cost < min_cost:
        min_cost = current_cost
        best_path = (0,) + path + (0,)

print("Minimum Cost:", min_cost)
print("Best Path:", best_path)
